# Copy to .env and fill in real values. .env is git-ignored.
# Load into your shell before running:  set -a; source .env; set +a; ./mvnw spring-boot:run

# PostgreSQL (matches docker-compose.yml: host port 5436, database "bookreview")
DATABASE_URL=jdbc:postgresql://localhost:5436/bookreview
DATABASE_USERNAME=your-db-user
DATABASE_PASSWORD=your-db-password

# Base64-encoded HMAC key, at least 32 bytes before encoding (e.g. `openssl rand -base64 32`)
JWT_SECRET=your-base64-secret-here

# Optional
# Password for the seeded `admin` account; admin seeding is skipped when unset
ADMIN_PASSWORD=
JWT_EXPIRATION=86400000
DDL_AUTO=update
PORT=8080
